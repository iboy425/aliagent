# 本文件是本地API配置模板，不要在这里填写真实Key。
# 使用方法：
#   cp .env.local.example .env.local
#   chmod 600 .env.local
#   编辑 .env.local，把下面的占位值替换成你的真实配置。

DASHSCOPE_API_KEY="替换为你的百炼API Key"
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL="qwen-plus"

# 可选：每次运行的输出目录和实验预算。
AGENT_OUTPUT_DIR="output/repro_agent_api_qwen_plus_round"
AGENT_BUDGET="1"
